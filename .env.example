# Factory Knowledge Twin — 환경변수 «키 목록만» (값 없음)
# 🔴 실제 값이 들어간 .env 는 절대 커밋하지 않는다 (baseline §34.6 · 공개 경계)
# 사용법: cp .env.example .env  후 로컬 값 채우기
#
# 🔴 **주석은 «키 줄 위»에 쓴다 — 같은 줄 뒤에 붙이지 않는다.** compose 의 env 파일 파서는
#    `KEY=   # 설명` 을 「빈 값 + 주석」으로 읽지 «않고» 값 자체를 `# 설명` 으로 읽는다
#    (실측 · compose v2.40.3). 앞판이 그 형식이라 이 파일을 그대로 복사하면
#    `invalid project name "# 스택 이름 접두 …"` 로 스택이 아예 뜨지 않았다.
#
# 🔴 이 파일은 «키 목록»이지 로더가 아니다. ai-api 는 .env 를 읽지 않고
#    (services/ai-api/app/settings.py 머리말) 실행 시점 환경변수만 본다.
#    각 키의 (층 · 시점) 표기와 좌표는 「누가 이 값을 실제로 읽는가」다.
#
# 🔴 전 키를 «빈 값»으로 두고 복사해도 안전하다 — compose 기본값이 그대로 선다(실측 확인).

# ── compose 격리 (D-1 · 좌석별 병렬 스택) ──────────────

# 스택 이름 접두 (기본 fkt) — 좌석마다 다르게 주면 동시 기동 가능
COMPOSE_PROJECT_NAME=
# bind mount 루트 (기본 ./.volumes) — 🔴 같은 워크트리 병렬 시 반드시 분리
VOLUME_ROOT=

# ── PostgreSQL (+pgvector) ─────────────────────────────

# DB 사용자명 (기본 fkt)
POSTGRES_USER=
# DB 비밀번호 — 로컬 개발용 임의값
POSTGRES_PASSWORD=
# DB 이름 (기본 fkt)
POSTGRES_DB=
# 호스트 노출 포트 (기본 5434 — 5432·5433 점유 회피)
POSTGRES_PORT=

# ── Neo4j ──────────────────────────────────────────────

# Neo4j 사용자명 (기본 neo4j)
NEO4J_USER=
# Neo4j 비밀번호 — 8자 이상
NEO4J_PASSWORD=
# Neo4j Browser 포트 (기본 7474)
NEO4J_HTTP_PORT=
# Bolt 드라이버 포트 (기본 7687)
NEO4J_BOLT_PORT=

# ── 서비스 포트 ────────────────────────────────────────

# FastAPI 포트 (기본 8000)
AI_API_PORT=
# Next.js dev 포트 (기본 3100 — 3000 점유 회피)
WEB_CONSOLE_PORT=

# ── ai-api 런타임 스위치 (compose → 컨테이너 env) ──────
# 🔴 아래 둘은 «컨테이너 안에서 런타임»에 읽힌다. compose 가 셸 값을 넘겨야 닿는다.

# (ai-api · 런타임) CORS allowlist, 쉼표 구분. 비우면 CORS 를 켜지 않는다 · `*` 는 목록에서 버려진다.
#   읽는 자리 = docker-compose.yml 의 `FKT_CORS_ORIGINS:` 줄 → services/ai-api/app/settings.py:54
FKT_CORS_ORIGINS=

# (ai-api · 런타임) 프록시 뒤 IP 를 X-Forwarded-For 첫 값으로 믿을지. 기본은 «안 믿는다».
#   읽는 자리 = docker-compose.yml 의 `FKT_TRUST_FORWARDED_FOR:` 줄 → services/ai-api/app/settings.py:93
#   🔴 값은 1/0 · true/false 만. 여기를 비워 두는 것은 안전하다(compose 가 false 로 채운다).
#      위험한 것은 컨테이너에 «빈 문자열»이 그대로 닿는 경우다 — bool 파싱 실패로 서비스가 죽는다.
FKT_TRUST_FORWARDED_FOR=

# ── compose 재시작 정책 (compose create 시점) ──────────

# (compose · create 시점) 기본 no. 배포 스택만 unless-stopped 로 «명시»한다.
#   읽는 자리 = docker-compose.yml 의 `restart:` 세 줄(서비스마다 1개) · 절차 = infra/laptop-operating-conditions.md §1
FKT_RESTART_POLICY=

# ── 셸(web-console) — 🔴 전부 «빌드 시점»에 구워진다 ───
# 🔴 next start 에만 주면 아무 일도 일어나지 않는다(목적지 변경 = 재빌드). 런타임에도 같은 값을
#    주면 통과하고, 빌드 값과 «다르게» 주면 부팅이 죽는다(apps/web-console/lib/boot-check.ts:26·56).

# (web-console · 빌드) ai-api 주소. 미설정 시 http://127.0.0.1:8000 으로 구워진다.
#   읽는 자리 = apps/web-console/next.config.ts:23 → 빌드 상수 FKT_API_BASE_BUILD(:68)
FKT_API_BASE=

# (web-console · 빌드) 정확히 문자열 "1" 일 때만 HSTS 를 붙인다. "true"·"yes" 는 꺼진 것이다.
#   읽는 자리 = apps/web-console/next.config.ts:56 → 빌드 상수 FKT_PUBLIC_HTTPS_BUILD(:69)
FKT_PUBLIC_HTTPS=

# ── 모델 (S2 이후 · 지금은 미사용) ─────────────────────

# 로컬 임베딩 모델 식별자
EMBEDDING_MODEL=
# 로컬/구독 모델 선택 스위치 — 🔴 공개 배포에 구독 키를 노출하지 않는다
LLM_PROVIDER=
