# Factory Knowledge Twin — 환경변수 «키 목록만» (값 없음)
# 🔴 실제 값이 들어간 .env 는 절대 커밋하지 않는다 (baseline §34.6 · 공개 경계)
# 사용법: cp .env.example .env  후 로컬 값 채우기

# ── compose 격리 (D-1 · 좌석별 병렬 스택) ──────────────
COMPOSE_PROJECT_NAME=   # 스택 이름 접두 (기본 fkt) — 좌석마다 다르게 주면 동시 기동 가능
VOLUME_ROOT=            # bind mount 루트 (기본 ./.volumes) — 🔴 같은 워크트리 병렬 시 반드시 분리

# ── PostgreSQL (+pgvector) ─────────────────────────────
POSTGRES_USER=          # DB 사용자명 (기본 fkt)
POSTGRES_PASSWORD=      # DB 비밀번호 — 로컬 개발용 임의값
POSTGRES_DB=            # DB 이름 (기본 fkt)
POSTGRES_PORT=          # 호스트 노출 포트 (기본 5434 — 5432·5433 점유 회피)

# ── Neo4j ──────────────────────────────────────────────
NEO4J_USER=             # Neo4j 사용자명 (기본 neo4j)
NEO4J_PASSWORD=         # Neo4j 비밀번호 — 8자 이상
NEO4J_HTTP_PORT=        # Neo4j Browser 포트 (기본 7474)
NEO4J_BOLT_PORT=        # Bolt 드라이버 포트 (기본 7687)

# ── 서비스 ─────────────────────────────────────────────
AI_API_PORT=            # FastAPI 포트 (기본 8000)
WEB_CONSOLE_PORT=       # Next.js dev 포트 (기본 3100 — 3000 점유 회피)
NEXT_PUBLIC_API_BASE=   # 웹콘솔이 호출할 API base (예: http://localhost:8000/api)

# ── 모델 (S2 이후 · 지금은 미사용) ─────────────────────
EMBEDDING_MODEL=        # 로컬 임베딩 모델 식별자
LLM_PROVIDER=           # 로컬/구독 모델 선택 스위치 — 🔴 공개 배포에 구독 키를 노출하지 않는다
