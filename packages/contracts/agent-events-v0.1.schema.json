{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fkt/contracts/agent-events-v0.1",
  "title": "FKT Agent Event Envelope v0.1",
  "description": "WebSocket(live)과 replay fixture가 공용하는 agent 진행 이벤트. replay는 동일 스키마에 mode=replay만 다르다. type↔payload는 allOf/if-then으로 «스키마 수준에서» 결속된다(검증 F-1·F-2 처방).",
  "type": "object",
  "required": ["runId", "seq", "ts", "mode", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0, "description": "run 내 단조 증가 — replay 재생 순서 보장" },
    "ts": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["live", "replay"] },
    "type": {
      "enum": [
        "run.started",
        "plan.updated",
        "step.started",
        "step.evidence",
        "step.completed",
        "run.completed",
        "run.stopped",
        "run.failed",
        "run.queued",
        "step.progress"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "run.started" } } },   "then": { "properties": { "payload": { "$ref": "#/$defs/runStarted" } } } },
    { "if": { "properties": { "type": { "const": "plan.updated" } } },  "then": { "properties": { "payload": { "$ref": "#/$defs/planUpdated" } } } },
    { "if": { "properties": { "type": { "const": "step.started" } } },  "then": { "properties": { "payload": { "$ref": "#/$defs/stepStarted" } } } },
    { "if": { "properties": { "type": { "const": "step.evidence" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/stepEvidence" } } } },
    { "if": { "properties": { "type": { "const": "step.completed" } } },"then": { "properties": { "payload": { "$ref": "#/$defs/stepCompleted" } } } },
    { "if": { "properties": { "type": { "const": "run.completed" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/runCompleted" } } } },
    { "if": { "properties": { "type": { "const": "run.stopped" } } },   "then": { "properties": { "payload": { "$ref": "#/$defs/runStopped" } } } },
    { "if": { "properties": { "type": { "const": "run.failed" } } },    "then": { "properties": { "payload": { "$ref": "#/$defs/runFailed" } } } },
    { "if": { "properties": { "type": { "const": "run.queued" } } },    "then": { "properties": { "payload": { "$ref": "#/$defs/runQueued" } } } },
    { "if": { "properties": { "type": { "const": "step.progress" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/stepProgress" } } } }
  ],
  "$defs": {
    "stepId": {
      "enum": ["structured", "vector", "graph", "synthesize", "draft_work_order"],
      "description": "LangGraph 조사 단계 — GS-01 S3~S7 대응"
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidenceId", "kind", "sourceId"],
      "additionalProperties": false,
      "properties": {
        "evidenceId": { "type": "string" },
        "kind": { "enum": ["alarm", "sensor-series", "record", "doc-chunk", "graph-path"] },
        "sourceId": { "type": "string", "description": "온톨로지 ID 체계(T0-6) 실체 참조" },
        "excerpt": { "type": "string", "description": "doc-chunk일 때 인용 문장" },
        "score": { "type": "number" },
        "revisionId": { "type": "string", "description": "doc-chunk: 인용한 문서 revision (신뢰 장치 — 검증 F-4)" },
        "contentHash": { "type": "string", "description": "doc-chunk: 인용 시점 문서 hash" },
        "stale": { "type": "boolean", "description": "doc-chunk: 색인이 최신 revision보다 낡았는지" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "doc-chunk" } } },
          "then": { "required": ["revisionId", "contentHash", "stale"] }
        }
      ]
    },
    "runStarted": {
      "type": "object",
      "required": ["scenarioId", "question"],
      "additionalProperties": false,
      "properties": {
        "scenarioId": { "type": "string" },
        "question": { "type": "string" }
      }
    },
    "planUpdated": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "array", "items": { "$ref": "#/$defs/stepId" }, "minItems": 1 }
      }
    },
    "stepStarted": {
      "type": "object",
      "required": ["step"],
      "additionalProperties": false,
      "properties": {
        "step": { "$ref": "#/$defs/stepId" },
        "note": { "type": "string" }
      }
    },
    "stepEvidence": {
      "type": "object",
      "required": ["step", "evidence"],
      "additionalProperties": false,
      "properties": {
        "step": { "$ref": "#/$defs/stepId" },
        "evidence": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "stepProgress": {
      "type": "object",
      "description": "v0.1.13 · 합성 진행 부분 결과 — 선표시(결정적 순위)와 문장 스트리밍. 형상 정본 = rest-api-v0.1.md v0.1.13 append. 🔴 `seq` 의 «단조성»은 이벤트 «열»의 성질이라 봉투 1건 스키마로는 못 잰다(런타임 축 — T6-3 검증에서 잰다).",
      "required": ["step", "kind", "seq"],
      "additionalProperties": false,
      "properties": {
        "step": { "const": "synthesize", "description": "선표시·스트리밍은 합성 단계 전용(정본 문면)" },
        "kind": { "enum": ["preliminary", "sentence"] },
        "seq": { "type": "integer", "minimum": 0, "description": "0부터 · 단조 — 여기서 서는 것은 «0 이상의 정수»까지다" },
        "preliminary": {
          "type": "object",
          "required": ["ranking", "axis"],
          "additionalProperties": false,
          "properties": {
            "ranking": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "failureModeId 순위 — 이미 계산된 결정적 값(지연 0)" },
            "axis": { "const": "deterministic", "description": "선표시는 언제나 결정적 축이다 — live 를 이 자리에서 주장하지 않는다" }
          }
        },
        "sentence": {
          "type": "object",
          "required": ["failureModeId", "text", "citedEvidenceIds"],
          "additionalProperties": false,
          "properties": {
            "failureModeId": { "type": "string" },
            "text": { "type": "string" },
            "citedEvidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "🔴 잠정 문장도 근거 없이는 오지 않는다 — 최종 가드(v0.1.11)와 같은 하한" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "preliminary" } } }, "then": { "required": ["step", "kind", "seq", "preliminary"] } },
        { "if": { "properties": { "kind": { "const": "sentence" } } },    "then": { "required": ["step", "kind", "seq", "sentence"] } },
        { "if": { "properties": { "kind": { "const": "preliminary" } } }, "then": { "properties": { "sentence": { "enum": [], "description": "🔴 배타 — 선표시 이벤트에 문장을 함께 싣지 않는다(오케 판정 09-03 14:25 · #443 도 한쪽만 emit). 빈 enum = 어떤 값도 통과하지 못한다 = 「이 자리에 오면 안 된다」." } } } },
        { "if": { "properties": { "kind": { "const": "sentence" } } },    "then": { "properties": { "preliminary": { "enum": [], "description": "🔴 배타 — 문장 이벤트에 선표시를 함께 싣지 않는다(같은 판정)." } } } }
      ]
    },
    "stepCompleted": {
      "type": "object",
      "required": ["step", "elapsedMs"],
      "additionalProperties": false,
      "properties": {
        "step": { "$ref": "#/$defs/stepId" },
        "summary": { "type": "string" },
        "elapsedMs": { "type": "integer", "minimum": 0, "description": "필수 — TTAE 합산 표시(검증 F-9)의 원천" },
        "strategy": { "enum": ["vector", "hybrid"], "description": "v0.2.0 · T7-44 — vector 단계가 어느 검색 전략의 근거집합인지(설정 FKT_RUN_RETRIEVAL_STRATEGY). 선택 · vector 단계 전용 · 부재 = 개정 이전 생산자(replay 픽스처 포함)" },
        "synthesis": {
          "type": "object",
          "required": ["axis"],
          "additionalProperties": false,
          "properties": {
            "axis": { "type": "string", "enum": ["live", "deterministic", "live-rejected"], "description": "v0.1.11 · 합성 축 — live-rejected = 게이트웨이 응답을 근거 결속 가드가 전량 거부(조용한 폴백 0)" },
            "model": { "type": "string" },
            "rejectedReason": { "type": "string" },
            "safetyOmitted": { "type": "boolean", "description": "v0.1.19 · D-84 — 근거 본문에 SAF-* 규정이 있는데 답변 문장이 호명하지 않아 1회 재요청 뒤에도 미호명 = 채택하되 참으로 표기(구현은 true 일 때만 실음 · false 와 부재는 같은 뜻 · 화면이 아니라 계측이 본다)" }
          }
        }
      },
      "allOf": [
        {
          "description": "v0.2.0 · T7-44 — strategy 는 vector 단계 전용이다(계약 v0.2.0 개정 ③). 여집합을 열거하지 않고 «strategy 가 있으면 step 은 vector» 로 적는다 — stepId 가 늘어도 이 규칙은 그대로 산다.",
          "if": { "required": ["strategy"] },
          "then": { "properties": { "step": { "const": "vector" } } }
        }
      ]
    },
    "runCompleted": {
      "type": "object",
      "required": ["candidates"],
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rank", "failureModeId", "label", "evidenceIds"],
            "additionalProperties": false,
            "properties": {
              "rank": { "type": "integer", "minimum": 1 },
              "failureModeId": { "type": "string" },
              "label": { "type": "string" },
              "confidenceNote": { "type": "string" },
              "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "rationale": {
                "type": "object",
                "required": ["sentences", "citedEvidenceIds"],
                "additionalProperties": false,
                "description": "v0.1.11 · live 합성 채택 시에만 — 인용 id 는 run 근거집합 안이어야 한다(가드가 보장)",
                "properties": {
                  "sentences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "citedEvidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                }
              }
            }
          }
        },
        "workOrderDraftId": { "type": "string" },
        "totalElapsedMs": { "type": "integer", "minimum": 0, "description": "조사 총 경과 — TTAE 표시용(검증 F-9)" }
      }
    },
    "runStopped": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "enum": ["user", "timeout", "reset"] },
        "note": { "type": "string" }
      },
      "description": "POST /runs/{id}/stop 대응 종료 신호(검증 F-3b) — 타임라인은 이 이벤트로 닫힌다"
    },
    "runFailed": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "fallback": { "enum": ["replay"], "description": "live 실패 시 replay 강등 신호" }
      }
    },
    "runQueued": {
      "type": "object",
      "required": ["position"],
      "additionalProperties": false,
      "properties": {
        "position": { "type": "integer", "minimum": 1, "description": "bounded queue 안의 순위(1 = 다음 실행)" },
        "estimatedWaitSec": { "type": ["integer", "null"], "minimum": 0, "description": "예상 대기 초 · 모르면 null(지어내지 않는다)" }
      },
      "description": "v0.1.9 append(T4-2b) — 동시 Live 상한에 걸려 큐에 «진입»한 run 의 신호(오류 아님 · 200 RunCreated 뒤 첫 이벤트 가능 · 순위 변동 시 같은 type 재발행 · 슬롯이 나면 run.started). replay fixture 에는 나오지 않는다"
    }
  }
}
