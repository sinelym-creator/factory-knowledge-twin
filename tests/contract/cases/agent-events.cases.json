{
  "name": "agent-events v0.1 — type↔payload 결속 (검증 F-1·F-2·F-3b·F-4)",
  "schema": "packages/contracts/agent-events-v0.1.schema.json",
  "note": "통과 케이스만으로는 결속이 증명되지 않는다 — «틀린 조합이 실제로 거부되는가»가 결속의 정의다. accept/reject를 짝으로 유지할 것.",
  "envelopeDefaults": {
    "runId": "R1",
    "seq": 0,
    "ts": "2026-08-28T06:00:00Z",
    "mode": "live"
  },
  "cases": [
    { "group": "① 정상 8종", "label": "run.started", "expect": "accept",
      "event": { "type": "run.started", "payload": { "scenarioId": "GS-01", "question": "q" } } },
    { "group": "① 정상 8종", "label": "plan.updated", "expect": "accept",
      "event": { "type": "plan.updated", "payload": { "steps": ["structured"] } } },
    { "group": "① 정상 8종", "label": "step.started(최소형)", "expect": "accept",
      "event": { "type": "step.started", "payload": { "step": "vector" } } },
    { "group": "① 정상 8종", "label": "step.evidence", "expect": "accept",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "doc-chunk", "sourceId": "DOC-SOP-0014@r2#007", "revisionId": "DOC-SOP-0014@r2", "contentHash": "abc", "stale": false } } } },
    { "group": "① 정상 8종", "label": "step.completed", "expect": "accept",
      "event": { "type": "step.completed", "payload": { "step": "vector", "elapsedMs": 120 } } },
    { "group": "① 정상 8종", "label": "step.completed에 elapsedMs 누락", "expect": "reject",
      "why": "F-9(TTAE 합산)의 원천이라 필수화됨 — 빠지면 거부돼야 한다",
      "event": { "type": "step.completed", "payload": { "step": "vector" } } },
    { "group": "① 정상 8종", "label": "run.completed", "expect": "accept",
      "event": { "type": "run.completed", "payload": { "candidates": [{ "rank": 1, "failureModeId": "FM-BRG-WEAR", "label": "베어링 마모", "evidenceIds": ["E1"] }] } } },
    { "group": "① 정상 8종", "label": "run.stopped(F-3b)", "expect": "accept",
      "event": { "type": "run.stopped", "payload": { "reason": "user" } } },
    { "group": "① 정상 8종", "label": "run.failed", "expect": "accept",
      "event": { "type": "run.failed", "payload": { "code": "E", "message": "m" } } },

    { "group": "② 오배선(F-2 본체)", "label": "completed에 failed payload", "expect": "reject",
      "event": { "type": "run.completed", "payload": { "code": "E", "message": "m" } } },
    { "group": "② 오배선(F-2 본체)", "label": "failed에 completed payload", "expect": "reject",
      "event": { "type": "run.failed", "payload": { "candidates": [{ "rank": 1, "failureModeId": "F", "label": "x", "evidenceIds": ["E1"] }] } } },
    { "group": "② 오배선(F-2 본체)", "label": "started에 completed 전용필드", "expect": "reject",
      "event": { "type": "step.started", "payload": { "step": "vector", "summary": "s" } } },
    { "group": "② 오배선(F-2 본체)", "label": "completed에 started 전용필드", "expect": "reject",
      "event": { "type": "step.completed", "payload": { "step": "vector", "elapsedMs": 1, "note": "n" } } },
    { "group": "② 오배선(F-2 본체)", "label": "stopped에 failed payload", "expect": "reject",
      "event": { "type": "run.stopped", "payload": { "code": "E", "message": "m" } } },
    { "group": "② 오배선(F-2 본체)", "label": "evidence에 started payload", "expect": "reject",
      "event": { "type": "step.evidence", "payload": { "step": "vector" } } },
    { "group": "② 오배선(F-2 본체)", "label": "미정의 stepId", "expect": "reject",
      "event": { "type": "step.started", "payload": { "step": "nope" } } },
    { "group": "② 오배선(F-2 본체)", "label": "미정의 stop reason", "expect": "reject",
      "event": { "type": "run.stopped", "payload": { "reason": "nope" } } },

    { "group": "③ 신뢰 필드(F-4)", "label": "doc-chunk에 revisionId 누락", "expect": "reject",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "doc-chunk", "sourceId": "S", "contentHash": "h", "stale": false } } } },
    { "group": "③ 신뢰 필드(F-4)", "label": "doc-chunk에 contentHash 누락", "expect": "reject",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "doc-chunk", "sourceId": "S", "revisionId": "R", "stale": false } } } },
    { "group": "③ 신뢰 필드(F-4)", "label": "doc-chunk에 stale 누락", "expect": "reject",
      "why": "선택이면 화면이 «신선함»과 «평가 안 함»을 구분할 수 없다(baseline §8.3)",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "doc-chunk", "sourceId": "S", "revisionId": "R", "contentHash": "h" } } } },
    { "group": "③ 신뢰 필드(F-4)", "label": "비 doc-chunk는 면제(alarm)", "expect": "accept",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E2", "kind": "alarm", "sourceId": "AL-20260826-0041" } } } },

    { "group": "④ replay ⊂ live", "label": "동일 payload가 mode만 바꿔 통과", "expect": "accept",
      "event": { "mode": "replay", "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "doc-chunk", "sourceId": "DOC-SOP-0014@r2#007", "revisionId": "DOC-SOP-0014@r2", "contentHash": "abc", "stale": false } } } },

    { "group": "⑤ envelope 형식", "expect": "reject", "label": "ts가 date-time이 아님",
      "why": "계약이 format:date-time을 선언한다 — 선언해 두고 아무 문자열이나 통과시키면 계약이 아니다",
      "event": { "ts": "어제쯤", "type": "run.stopped", "payload": { "reason": "user" } } },
    { "group": "⑤ envelope 형식", "expect": "reject", "label": "seq 음수(minimum 위반)",
      "event": { "seq": -1, "type": "run.stopped", "payload": { "reason": "user" } } },
    { "group": "⑤ envelope 형식", "expect": "reject", "label": "미정의 mode",
      "event": { "mode": "sandbox", "type": "run.stopped", "payload": { "reason": "user" } } },

    { "group": "⑥ 선택 필드(커버리지)", "label": "run.completed 선택 필드 전부", "expect": "accept",
      "why": "totalElapsedMs·workOrderDraftId·confidenceNote가 케이스에 한 번도 안 나오면 타입이 바뀌어도 harness가 모른다",
      "event": { "type": "run.completed", "payload": { "candidates": [{ "rank": 1, "failureModeId": "FM-BRG-WEAR", "label": "베어링 마모", "confidenceNote": "1순위", "evidenceIds": ["E1"] }], "workOrderDraftId": "WO-2026-0113", "totalElapsedMs": 72000 } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "totalElapsedMs 음수", "expect": "reject",
      "event": { "type": "run.completed", "payload": { "candidates": [{ "rank": 1, "failureModeId": "F", "label": "x", "evidenceIds": ["E1"] }], "totalElapsedMs": -1 } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "evidence 선택 필드(excerpt·score)", "expect": "accept",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "doc-chunk", "sourceId": "DOC-MAN-0021@r1#014", "revisionId": "DOC-MAN-0021@r1", "contentHash": "abc", "stale": false, "excerpt": "베어링 마모 시 진동 RMS가 상승한다", "score": 0.82 } } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "score가 숫자가 아님", "expect": "reject",
      "event": { "type": "step.evidence", "payload": { "step": "vector", "evidence": { "evidenceId": "E1", "kind": "alarm", "sourceId": "AL-20260826-0041", "score": "높음" } } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "run.failed fallback=replay", "expect": "accept",
      "event": { "type": "run.failed", "payload": { "code": "LIVE_OFFLINE", "message": "live 불가", "fallback": "replay" } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "미정의 fallback 값", "expect": "reject",
      "event": { "type": "run.failed", "payload": { "code": "E", "message": "m", "fallback": "sandbox" } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "step.started의 note", "expect": "accept",
      "why": "노드 기준 커버리지가 잡아낸 미실행 3건 — 문자열 매칭으로는 «덮였다»고 잘못 세던 자리",
      "event": { "type": "step.started", "payload": { "step": "graph", "note": "그래프 경로 추적 시작" } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "step.completed의 summary", "expect": "accept",
      "event": { "type": "step.completed", "payload": { "step": "graph", "summary": "4-hop 경로 1건 확보", "elapsedMs": 340 } } },
    { "group": "⑥ 선택 필드(커버리지)", "label": "run.stopped의 note", "expect": "accept",
      "event": { "type": "run.stopped", "payload": { "reason": "timeout", "note": "live 응답 지연" } } },

    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "최소형(position만)", "expect": "accept",
      "why": "position은 required — 이 한 건이 없어 두 속성이 «한 번도 실행되지 않았다»(strict-coverage 빨강의 실체)",
      "event": { "type": "run.queued", "payload": { "position": 1 } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "예상 대기 있음(정수)", "expect": "accept",
      "event": { "type": "run.queued", "payload": { "position": 3, "estimatedWaitSec": 45 } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "모르면 null(지어내지 않는다)", "expect": "accept",
      "why": "계약이 integer|null을 «허용»한다는 것과, 러너가 그 union을 지킨다는 것은 다른 사실이다 — 아래 거부 짝이 그 둘을 가른다",
      "event": { "type": "run.queued", "payload": { "position": 2, "estimatedWaitSec": null } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "position 누락(required)", "expect": "reject",
      "event": { "type": "run.queued", "payload": { "estimatedWaitSec": 10 } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "position 0(minimum 1 — 1이 다음 실행)", "expect": "reject",
      "event": { "type": "run.queued", "payload": { "position": 0 } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "position이 문자열", "expect": "reject",
      "event": { "type": "run.queued", "payload": { "position": "1" } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "estimatedWaitSec이 문자열", "expect": "reject",
      "why": "🔴 앞판 러너는 이것을 통과시켰다 — union type을 문자열 동등으로만 봐서 검사가 통째로 빠졌다(validator.js 수리와 짝)",
      "event": { "type": "run.queued", "payload": { "position": 1, "estimatedWaitSec": "곧" } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "estimatedWaitSec이 실수(integer 아님)", "expect": "reject",
      "event": { "type": "run.queued", "payload": { "position": 1, "estimatedWaitSec": 3.7 } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "estimatedWaitSec 음수(minimum 0)", "expect": "reject",
      "event": { "type": "run.queued", "payload": { "position": 1, "estimatedWaitSec": -5 } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "queued에 failed payload(F-2 결속)", "expect": "reject",
      "event": { "type": "run.queued", "payload": { "code": "E", "message": "m" } } },
    { "group": "⑦ run.queued(v0.1.9 · T4-2b)", "label": "stopped에 queued payload(F-2 결속)", "expect": "reject",
      "event": { "type": "run.stopped", "payload": { "position": 1 } } }
  ]
}
